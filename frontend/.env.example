# Copy to .env.local and fill in. Never commit real values.

# PayPal REST app (sandbox) - https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Webhook ID from the same app, registered at <APP_URL>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=

# Anthropic API - https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: Claude model used by the sales agent
ANTHROPIC_MODEL=claude-sonnet-4-6

# Public base URL of this app (used for PayPal return/cancel URLs)
APP_URL=http://localhost:3000
